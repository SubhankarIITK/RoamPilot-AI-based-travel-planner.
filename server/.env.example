PORT=5000
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/roampilot
MONGO_DB_NAME=roampilot
API_RATE_LIMIT_MAX=600
PLANNING_PROGRESS_RATE_LIMIT_MAX=600
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_SIGNUP_RATE_LIMIT_MAX=5
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
OTP_SECRET=use_a_different_long_random_secret_for_otp_hashing
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_FROM=RoamPilot <your_email@gmail.com>
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_PLANNER_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_AGENT_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_ITINERARY_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_SPEECH_MODEL=whisper-large-v3-turbo
GROQ_SPEECH_MIN_INTERVAL_MS=3200
# Maximum only: the planner automatically caps >7-day trips at 2 days per
# batch and >17-day trips at 1 day per batch.
GROQ_ITINERARY_BATCH_SIZE=3
GROQ_MIN_INTERVAL_MS=2100
GROQ_TPM_SAFETY_RATIO=0.8
# Active planners heartbeat every 15 seconds. A missed heartbeat becomes resumable.
PLANNING_STALE_AFTER_MS=90000
TAVILY_API_KEY=tvly-your_tavily_api_key
# Optional Tavily usage tracking and conservative request pacing.
# TAVILY_PROJECT_ID=your_tavily_project_id
TAVILY_MIN_INTERVAL_MS=500
TAVILY_TIMEOUT_MS=15000
RESEARCH_CACHE_TTL_HOURS=6
# Structured travel facts. Each provider can be enabled independently.
# All listed developer/test tiers can be created without a credit card.
GEOAPIFY_API_KEY=your_geoapify_api_key
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key
# Shared safety controls for external travel-data providers.
TRAVEL_API_MIN_INTERVAL_MS=300
TRAVEL_API_TIMEOUT_MS=9000
GEOAPIFY_SEARCH_RADIUS_METERS=15000
PEXELS_API_KEY=
IMAGE_CACHE_TTL_HOURS=720
# Open-Meteo weather uses no API key. Cache protects the free public service.
WEATHER_CACHE_TTL_MINUTES=30
TRIP_CARD_IMAGE_LIMIT=6
# Optional: set this to the exact TPM shown in your Groq dashboard.
# GROQ_TPM_LIMIT=30000
CLIENT_URL=http://localhost:5173
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=use_a_separate_long_webhook_secret
WEEKLY_FREE_CREDITS=39
CREDIT_EXEMPT_EMAILS=subhankarsutradhar2004@gmail.com,subhankar2004@gmail.com
