# Local development:
VITE_API_BASE_URL=http://localhost:5000/api
# Vercel production uses the /api proxy configured in client/vercel.json.

# Optional browser-restricted Geoapify key for interactive map tiles.
# Without it, RoamPilot uses normal OpenStreetMap tiles as a low-volume fallback.
VITE_GEOAPIFY_MAP_KEY=
